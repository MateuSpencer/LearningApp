# This file is not added to git, copy from .env.local.example
APP_VERSION=1.0.0

# Authentication settings
SESSION_COOKIE_SECURE=True

# Wagtail API settings
WAGTAIL_API_URL=http://localhost:8081/wt/api/nextjs
NEXT_PUBLIC_WAGTAIL_API_URL=/wt/api/nextjs

# Secret key for development - should be different in production
SECRET_KEY=your-secret-key-for-development

# AI Provider API Keys
# Tavily API key for web search (get yours at https://tavily.com/)
# Used for the AI learning resources search when NEXT_PUBLIC_AI_PROVIDER=tavily
NEXT_PUBLIC_TAVILY_API_KEY=your-tavily-api-key

# Other AI providers (uncomment if needed)
# NEXT_PUBLIC_TOGETHER_AI_API_KEY=your-together-ai-api-key
# NEXT_PUBLIC_AZURE_OPENAI_API_KEY=your-azure-openai-key
# NEXT_PUBLIC_AZURE_OPENAI_ENDPOINT=your-azure-endpoint
# NEXT_PUBLIC_AZURE_OPENAI_DEPLOYMENT=your-azure-deployment-name
# NEXT_PUBLIC_GOOGLE_AI_API_KEY=your-google-api-key
# NEXT_PUBLIC_OPENAI_API_KEY=your-openai-api-key

# Set which AI provider to use: tavily, together, azure, google, openai
# Default to tavily for learning resource search
NEXT_PUBLIC_AI_PROVIDER=tavily
