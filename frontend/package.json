{
  "name": "frontend_nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "build:local": "IGNORE_SENTRY=1 next build",
    "start": "next start -p 3000",
    "storybook": "storybook dev -p 3001",
    "build-storybook": "storybook build",
    "fixcode": "npx prettier \"**/*(*.css|*.js|*.json|*.md|*.scss)\" --write",
    "new": "node cli/bin.js new",
    "new:container": "node cli/bin.js new --container",
    "test": "jest --watch",
    "test:ci": "npx jest --ci --runInBand --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "@github/webauthn-json": "^2.1.1",
    "@langchain/community": "^0.3.42",
    "@langchain/core": "^0.3.55",
    "@langchain/google-genai": "^0.2.9",
    "@langchain/openai": "^0.5.10",
    "@langchain/tavily": "^0.1.1",
    "@sentry/nextjs": "^8.54.0",
    "dompurify": "^3.0.6",
    "i18next": "^24.2.2",
    "next": "^15.2.4",
    "next-i18next": "^15.4.2",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-datepicker": "^8.3.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "whatwg-fetch": "^3.6.2",
    "zod": "^3.24.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged --pattern 'frontend/**' && jest --onlyChanged",
      "pre-push": ""
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.12",
    "@storybook/addon-actions": "^8.6.12",
    "@storybook/addon-backgrounds": "^8.6.12",
    "@storybook/addon-viewport": "^8.6.12",
    "@storybook/nextjs": "^8.6.12",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "cross-env": "^7.0.3",
    "eslint": "9.20.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^29.6.2",
    "jest-environment-jsdom": "^29.6.2",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "pretty-quick": "^4.0.0",
    "storybook": "^8.6.12",
    "web-streams-polyfill": "^4.1.0"
  }
}
