# App version
APP_VERSION={{ app_version | default('1.0.0') }}

# Frontend URLs
FRONTEND_BASE_URL=https://{{ domain }}
API_URL=https://{{ domain }}
API_BASE_URL=/api
CORS_ALLOW_ORIGIN=*

# Authentication settings
SESSION_COOKIE_SECURE=True
SECRET_KEY={{ secret_key }}

# Wagtail API settings
WAGTAIL_API_URL=https://{{ domain }}/wt/api/nextjs
NEXT_PUBLIC_WAGTAIL_API_URL=https://{{ domain }}/wt/api/nextjs

# Sentry configuration
NEXT_PUBLIC_SENTRY_DSN={{ sentry_dsn | default('') }}
SENTRY_ENVIRONMENT={{ stage_name }}
SENTRY_ORG={{ sentry_org | default('') }}
SENTRY_PROJECT={{ project_slug }}
SENTRY_AUTH_TOKEN={{ sentry_auth_token | default('') }}

# AI Provider settings
NEXT_PUBLIC_AI_PROVIDER={{ ai_provider | default('together') }}
NEXT_PUBLIC_TOGETHER_AI_API_KEY={{ together_ai_api_key | default('') }}
NEXT_PUBLIC_TAVILY_API_KEY={{ tavily_api_key | default('') }}

